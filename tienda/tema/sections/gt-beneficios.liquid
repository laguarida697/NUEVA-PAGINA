{{ 'gt-styles.css' | asset_url | stylesheet_tag }}
{% style %}
  #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background: {{ section.settings.bg_color }}; }
  #shopify-section-{{ section.id }} .gt-cabecera { text-align: {{ section.settings.text_align }}; }
  #shopify-section-{{ section.id }} .gt-titulo { font-size: {{ section.settings.heading_size }}px; }
  #shopify-section-{{ section.id }} .gt-texto { font-size: {{ section.settings.body_size }}px; }
  #shopify-section-{{ section.id }} .gt-ben-grid { --gt-cols: {{ section.settings.columns }}; gap: {{ section.settings.gap }}px; }
  @media (max-width: 989px) { #shopify-section-{{ section.id }} .gt-titulo { font-size: {{ section.settings.heading_size | times: 0.7 | round }}px; } }
{% endstyle %}
<section class="gt-section">
  <div class="gt-container">
    <div class="gt-cabecera">
      {%- if section.settings.eyebrow != blank -%}<span class="gt-eyebrow gt-reveal">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="gt-titulo gt-reveal" style="--gt-delay:.06s">{{ section.settings.heading }}</h2>
    </div>
    <div class="gt-ben-grid">
      {%- for block in section.blocks -%}
        <div class="gt-ben gt-reveal" style="--gt-delay: {{ forloop.index0 | times: 0.08 }}s" {{ block.shopify_attributes }}>
          <span class="gt-ben__icono" style="display:block">{% render 'gt-icono', nombre: block.settings.icon %}</span>
          <h3 class="gt-ben__titulo">{{ block.settings.title }}</h3>
          <p class="gt-texto" style="font-size:{{ section.settings.body_size }}px">{{ block.settings.text | newline_to_br }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
<script src="{{ 'gt-scripts.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "GT – Beneficios",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Frase pequeña", "default": "Por qué La Guarida" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Compra sin sustos" },
    { "type": "color", "id": "bg_color", "label": "Color de fondo", "default": "#120b1a" },
    { "type": "header", "content": "Diseño" },
    { "type": "select", "id": "text_align", "label": "Alineación del título", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" }, { "value": "right", "label": "Derecha" } ], "default": "center" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título", "min": 28, "max": 90, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "body_size", "label": "Tamaño del texto", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "columns", "label": "Columnas (ordenador)", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "range", "id": "gap", "label": "Separación", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 22 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "beneficio",
      "name": "Beneficio",
      "settings": [
        { "type": "select", "id": "icon", "label": "Dibujo", "options": [ { "value": "calabaza", "label": "Calabaza" }, { "value": "murcielago", "label": "Murciélago" }, { "value": "fantasma", "label": "Fantasma" }, { "value": "bruja", "label": "Sombrero de bruja" }, { "value": "caja", "label": "Caja de envío" }, { "value": "escudo", "label": "Escudo (seguridad)" }, { "value": "estrella", "label": "Estrella" }, { "value": "ninos", "label": "Niños" } ], "default": "caja" },
        { "type": "text", "id": "title", "label": "Título", "default": "Envíos a Colombia" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Te lo llevamos a casa en todo el país." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "GT – Beneficios", "blocks": [ { "type": "beneficio" }, { "type": "beneficio" }, { "type": "beneficio" }, { "type": "beneficio" } ] }
  ]
}
{% endschema %}
