{{ 'gt-styles.css' | asset_url | stylesheet_tag }}
{% style %}
  #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background: var(--gt-noche, #120b1a); }
  #shopify-section-{{ section.id }} .gt-marquesina { background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; }
  #shopify-section-{{ section.id }} .gt-marquesina__pista { --gt-vel: {{ section.settings.speed }}s; }
  #shopify-section-{{ section.id }} .gt-marquesina__item { font-size: {{ section.settings.text_size }}px; }
{% endstyle %}
{%- assign frases = section.settings.phrases | newline_to_br | split: '<br />' -%}
<section class="gt-section gt-marquesina" aria-label="Avisos">
  <div class="gt-marquesina__pista">
    {%- for i in (1..2) -%}
      {%- for f in frases -%}
        {%- assign t = f | strip | strip_newlines -%}
        {%- if t != blank -%}<span class="gt-marquesina__item" {% if i == 2 %}aria-hidden="true"{% endif %}>{{ t }}{% render 'gt-icono', nombre: 'murcielago' %}</span>{%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "GT – Marquesina",
  "tag": "section",
  "settings": [
    { "type": "textarea", "id": "phrases", "label": "Frases (una por línea)", "default": "Envíos a toda Colombia\nDisfraces para niños y adultos\nPide antes del 25 de octubre\nNoche de brujas 31 de octubre\nCompra segura" },
    { "type": "color", "id": "bg_color", "label": "Color de fondo", "default": "#ff7a1a" },
    { "type": "color", "id": "text_color", "label": "Color del texto", "default": "#1a0d00" },
    { "type": "range", "id": "text_size", "label": "Tamaño del texto", "min": 14, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "speed", "label": "Duración de la vuelta (más alto = más lento)", "min": 10, "max": 80, "step": 5, "unit": "s", "default": 30 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 0 }
  ],
  "presets": [ { "name": "GT – Marquesina" } ]
}
{% endschema %}
