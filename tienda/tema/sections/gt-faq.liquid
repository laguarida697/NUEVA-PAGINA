{{ 'gt-styles.css' | asset_url | stylesheet_tag }}
{% style %}
  #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background: {{ section.settings.bg_color }}; }
  #shopify-section-{{ section.id }} .gt-cabecera { text-align: {{ section.settings.text_align }}; }
  #shopify-section-{{ section.id }} .gt-titulo { font-size: {{ section.settings.heading_size }}px; }
  #shopify-section-{{ section.id }} .gt-faq summary { font-size: {{ section.settings.question_size }}px; }
  #shopify-section-{{ section.id }} .gt-faq__resp { font-size: {{ section.settings.body_size }}px; }
  @media (max-width: 989px) { #shopify-section-{{ section.id }} .gt-titulo { font-size: {{ section.settings.heading_size | times: 0.7 | round }}px; } }
{% endstyle %}
<section class="gt-section">
  <div class="gt-container">
    <div class="gt-cabecera">
      {%- if section.settings.eyebrow != blank -%}<span class="gt-eyebrow gt-reveal">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="gt-titulo gt-reveal" style="--gt-delay:.06s">{{ section.settings.heading }}</h2>
    </div>
    <div class="gt-faq">
      {%- for block in section.blocks -%}
        <details class="gt-reveal" style="--gt-delay: {{ forloop.index0 | times: 0.06 }}s" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="gt-faq__resp">{{ block.settings.answer | newline_to_br }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
<script src="{{ 'gt-scripts.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "GT – Preguntas frecuentes",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Frase pequeña", "default": "Dudas" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Preguntas frecuentes" },
    { "type": "color", "id": "bg_color", "label": "Color de fondo", "default": "#120b1a" },
    { "type": "select", "id": "text_align", "label": "Alineación del título", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" }, { "value": "right", "label": "Derecha" } ], "default": "center" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título", "min": 28, "max": 90, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "question_size", "label": "Tamaño de las preguntas", "min": 14, "max": 26, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "body_size", "label": "Tamaño de las respuestas", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "pregunta",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta", "default": "¿Cuánto tarda el envío?" },
        { "type": "textarea", "id": "answer", "label": "Respuesta", "default": "Escribe aquí la respuesta." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [ { "name": "GT – Preguntas frecuentes", "blocks": [ { "type": "pregunta" }, { "type": "pregunta" } ] } ]
}
{% endschema %}
