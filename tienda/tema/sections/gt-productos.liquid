{{ 'gt-styles.css' | asset_url | stylesheet_tag }}
{% style %}
  #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background: {{ section.settings.bg_color }}; }
  #shopify-section-{{ section.id }} .gt-cabecera { text-align: {{ section.settings.text_align }}; }
  #shopify-section-{{ section.id }} .gt-titulo { font-size: {{ section.settings.heading_size }}px; }
  #shopify-section-{{ section.id }} .gt-texto { font-size: {{ section.settings.body_size }}px; }
  #shopify-section-{{ section.id }} .gt-prod-grid { --gt-cols: {{ section.settings.columns }}; gap: {{ section.settings.gap }}px; }
  @media (max-width: 989px) { #shopify-section-{{ section.id }} .gt-titulo { font-size: {{ section.settings.heading_size | times: 0.7 | round }}px; } }
{% endstyle %}
{%- assign col = section.settings.collection -%}
<section class="gt-section">
  <div class="gt-container">
    <div class="gt-cabecera">
      {%- if section.settings.eyebrow != blank -%}<span class="gt-eyebrow gt-reveal">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="gt-titulo gt-reveal" style="--gt-delay:.06s">{{ section.settings.heading }}</h2>
      {%- if section.settings.subtitle != blank -%}<p class="gt-texto gt-reveal" style="--gt-delay:.12s;margin-top:14px">{{ section.settings.subtitle | newline_to_br }}</p>{%- endif -%}
    </div>
    <div class="gt-prod-grid">
      {%- if col != blank and col.products_count > 0 -%}
        {%- for product in col.products limit: section.settings.limit -%}
          <a class="gt-prod gt-reveal" style="--gt-delay: {{ forloop.index0 | times: 0.07 }}s" href="{{ product.url }}">
            <div class="gt-prod__media">
              {%- if product.featured_image != blank -%}
                <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="700" height="700">
              {%- else -%}
                {% render 'gt-icono', nombre: 'calabaza' %}
              {%- endif -%}
              {%- if product.compare_at_price > product.price -%}<span class="gt-prod__etiqueta">Oferta</span>{%- elsif product.available == false -%}<span class="gt-prod__etiqueta">Agotado</span>{%- endif -%}
            </div>
            <div class="gt-prod__info">
              <h3 class="gt-prod__nombre">{{ product.title }}</h3>
              <span class="gt-prod__precio">{{ product.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</span>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.columns) -%}
          <div class="gt-prod gt-reveal" style="--gt-delay: {{ forloop.index0 | times: 0.07 }}s">
            <div class="gt-prod__media">{% render 'gt-icono', nombre: 'calabaza' %}</div>
            <div class="gt-prod__info"><h3 class="gt-prod__nombre">{{ section.settings.empty_text }}</h3><span class="gt-prod__precio">$ —</span></div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if section.settings.btn_text != blank and col != blank -%}
      <div class="gt-centro"><a class="gt-btn gt-btn--borde" href="{{ col.url }}">{{ section.settings.btn_text }}</a></div>
    {%- endif -%}
  </div>
</section>
<script src="{{ 'gt-scripts.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "GT – Productos",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Colección a mostrar" },
    { "type": "text", "id": "eyebrow", "label": "Frase pequeña", "default": "Lo más pedido" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Disfraces para niños" },
    { "type": "textarea", "id": "subtitle", "label": "Texto (opcional)" },
    { "type": "text", "id": "empty_text", "label": "Texto mientras no hay productos", "default": "Próximamente" },
    { "type": "text", "id": "btn_text", "label": "Texto del botón final", "default": "Ver toda la colección" },
    { "type": "color", "id": "bg_color", "label": "Color de fondo", "default": "#120b1a" },
    { "type": "header", "content": "Diseño" },
    { "type": "select", "id": "text_align", "label": "Alineación del título", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" }, { "value": "right", "label": "Derecha" } ], "default": "center" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título", "min": 28, "max": 90, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "body_size", "label": "Tamaño del texto", "min": 13, "max": 24, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "columns", "label": "Productos por fila (ordenador)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "limit", "label": "Máximo de productos", "min": 2, "max": 20, "step": 1, "default": 8 },
    { "type": "range", "id": "gap", "label": "Separación", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 22 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "GT – Productos" } ]
}
{% endschema %}
